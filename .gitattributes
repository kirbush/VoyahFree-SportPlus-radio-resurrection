# Android mksh treats CRLF as part of shell tokens. Preserve LF in every checkout.
*.sh text eol=lf
*.py text eol=lf
*.java text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.apk binary
*.zip binary
*.service text eol=lf
*.conf text eol=lf
